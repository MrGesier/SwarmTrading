# Add these to the OpenBot deployment environment.
TENANT_PACKAGE_DIR=../examples/swarmtrade
AGENT_ENDPOINT_ALLOWED_HOSTS=host.docker.internal:8000
# The same random secret must be configured in Darwin as OPENBOT_AGENT_TOKEN.
MANAGED_AGENT_TOKEN=CHANGE_ME_RANDOM_SECRET

# Optional explicit URLs if OpenBot and Darwin are not on the same laptop/Docker host.
SWARMTRADE_ATLAS_AG_UI_URL=http://host.docker.internal:8000/ag-ui/atlas
SWARMTRADE_CURIE_AG_UI_URL=http://host.docker.internal:8000/ag-ui/curie
SWARMTRADE_EVOLVE_AG_UI_URL=http://host.docker.internal:8000/ag-ui/evolve
SWARMTRADE_MNEMOSYNE_AG_UI_URL=http://host.docker.internal:8000/ag-ui/mnemosyne

# === Darwin paper research ===
DARWIN_PAPER_NOTIONAL_USD=1000
DARWIN_PAPER_FEE_BPS=3.5
DARWIN_MIN_SAMPLE_SECONDS=300
DARWIN_MIN_CLOSED_TRADES=5
DARWIN_PROMOTION_MIN_SECONDS=900
DARWIN_PROMOTION_MIN_TRADES=12
DARWIN_EPOCH_SECONDS=86400
DARWIN_AUTO_EPOCH_ENABLED=true
DARWIN_MULTIPLE_TESTING_GUARD=true
DARWIN_REQUIRE_POSITIVE_FEE_STRESS=true
DARWIN_FEE_STRESS_MULTIPLIER=1.5
DARWIN_MAX_ACTIVE_STRATEGIES=400
DARWIN_MAX_NEW_PER_EPOCH=12
DARWIN_AUTOSTART_SYMBOL=BTCUSDT
DARWIN_AUTOSTART_MODE=live
DARWIN_MARKET_SOURCE=hyperliquid
DARWIN_DATA_DIR=./data

# === OpenAI Brain (research/advisory only) ===
# Direct OpenAI Responses API. Keep this secret outside Git.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DARWIN_LLM_ENABLED=true
DARWIN_LLM_TIMEOUT_SECONDS=60
DARWIN_LLM_MAX_CONTEXT_CHARS=60000

# Per-agent runtimes: openai | gateway | deterministic
DARWIN_BRAIN_ATLAS=openai
DARWIN_BRAIN_CURIE=openai
DARWIN_BRAIN_EVOLVE=openai
DARWIN_BRAIN_FORGE=deterministic
DARWIN_BRAIN_JUDGE=openai
DARWIN_BRAIN_MNEMOSYNE=openai
DARWIN_BRAIN_CERBERUS=deterministic
DARWIN_BRAIN_HERMES=deterministic

# Model routing: strongest models only where reasoning is useful.
DARWIN_MODEL_ATLAS=gpt-5.6-sol
DARWIN_MODEL_CURIE=gpt-5.6-sol
DARWIN_MODEL_EVOLVE=gpt-5.6-terra
DARWIN_MODEL_FORGE=deterministic-paper-engine
DARWIN_MODEL_JUDGE=gpt-5.6-terra
DARWIN_MODEL_MNEMOSYNE=gpt-5.6-luna
DARWIN_MODEL_CERBERUS=deterministic-risk-gate
DARWIN_MODEL_HERMES=deterministic-executor
DARWIN_REASONING_ATLAS=high
DARWIN_REASONING_CURIE=high
DARWIN_REASONING_EVOLVE=medium
DARWIN_REASONING_JUDGE=medium
DARWIN_REASONING_MNEMOSYNE=low

# Optional legacy/alternative gateway runtime for individual agents.
AI_GATEWAY_API_KEY=
DARWIN_LLM_BASE_URL=https://ai-gateway.vercel.sh/v1

# === Codex Engineer (outside trading loop) ===
# V0.10 prepares auditable task packs; it never auto-applies code changes.
CODEX_ENGINEER_ENABLED=false
CODEX_ENGINEER_MODEL=gpt-6-astra
CODEX_ENGINEER_ENVIRONMENT=openai_hosted

# === Hyperliquid public market data ===
# Mainnet public data is safe for paper trading and needs no wallet.
HYPERLIQUID_DATA_NETWORK=mainnet

# === Hyperliquid execution ===
# OFF by default. Prefer an API wallet key, never a primary-wallet private key.
HYPERLIQUID_ENABLED=false
HYPERLIQUID_NETWORK=testnet
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_API_PRIVATE_KEY=
HYPERLIQUID_MAX_NOTIONAL_USD=100
# Required in addition to HYPERLIQUID_ENABLED=true if HYPERLIQUID_NETWORK=mainnet
HYPERLIQUID_MAINNET_ACK=

# Optional CopilotKit/OpenBot AG-UI bridge. Leave unset to keep the bridge disabled.
# Generate a random secret; configure the same value as MANAGED_AGENT_TOKEN in OpenBot.
OPENBOT_AGENT_TOKEN=
OPENBOT_ATLAS_MODEL=gpt-5.6-sol
OPENBOT_CURIE_MODEL=gpt-5.6-sol
OPENBOT_EVOLVE_MODEL=gpt-5.6-terra
OPENBOT_MNEMOSYNE_MODEL=gpt-5.6-luna

# === Raw event recorder retention (V0.10) ===
# Disable entirely on constrained hosts or cap the number of part files kept per session.
DARWIN_RECORD_RAW=true
DARWIN_RECORD_MAX_PARTS=240
